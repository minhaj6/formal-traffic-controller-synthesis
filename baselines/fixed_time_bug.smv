-- The same fixed-time controller with a typical mistake: the designer reused
-- the 2 s all-red interval of the NS street after the EW yellow, where the
-- wider EW crossing needs 3 s.  The cycle is 30 s instead of 31 s.
MODULE main
VAR
  call_ns : boolean;
  call_ew : boolean;
  t : 0..29;
DEFINE
  g_ns := t >= 1  & t <= 10;
  y_ns := t >= 11 & t <= 15;       -- all red 16-17
  g_ew := t >= 18 & t <= 24;
  y_ew := t >= 25 & t <= 28;       -- all red 29 and 0  (one second short)
ASSIGN
  init(t) := 0;
  next(t) := (t + 1) mod 30;
